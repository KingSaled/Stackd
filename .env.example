# ---------------------------------------------------------------------------
# Stackd environment variables
#
# Netlify: Site configuration → Environment variables (scope: Builds + Functions)
# Local:   copy to `.env` and run `npx netlify dev`
#
# Values come from Supabase → Project Settings → API (or "API Keys").
# ---------------------------------------------------------------------------

# Project URL, e.g. https://abcdefghijklmnop.supabase.co
SUPABASE_URL=

# Public anon key (or the new "publishable" key, sb_publishable_...).
# Safe to expose: it is embedded in the browser bundle at build time.
SUPABASE_ANON_KEY=

# Service role key (or the new "secret" key, sb_secret_...).
# SECRET — only used by Netlify Functions. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=
